\name{install_license}
\alias{install_license}
\title{Install a residencyR license file}
\usage{
install_license(license_text, path)
}
\arguments{
\item{license_text}{Character. The full contents of a license file, exactly as issued at purchase or renewal.}
\item{path}{Character or NULL. Where to install it. Defaults to the standard per-user location.}
}
\value{
Invisibly, the path the license was written to.
}
\description{
Install a residencyR license file
}
